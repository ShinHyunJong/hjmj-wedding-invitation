# 실제 값은 .env (gitignore) 와 Vercel 환경변수에. 이 파일은 이름만 보여주는 견본.

# 카카오 JavaScript 키 (카카오톡 공유 · 카카오내비). developers.kakao.com → 앱 키
KAKAO_JS_KEY=

# 네이버 지도 Client ID (NCP Maps Application). ncloud.com → AI·NAVER API → Application
NAVER_CLIENT_ID=

# RDS MySQL (참석 의사 · 방명록 · 사진 목록)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=wedding

# S3 (하객 사진). 버킷 rechee-platform-asset 의 wedding/ 아래에 저장
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 선택: 기본값 rechee-platform-asset / ap-northeast-2 / wedding
# S3_BUCKET=
# S3_REGION=
# S3_PREFIX=

# 관리자 CSV 내보내기 토큰 (/api/admin/export?type=rsvp&token=...). 길고 무작위한 값으로.
ADMIN_TOKEN=

# 선택: 1 이면 예식일 전에도 사진 업로드 허용 (테스트용)
# PHOTO_UPLOAD_OPEN=1

# 선택: 배포 도메인 (OG 이미지 절대경로)
# NEXT_PUBLIC_SITE_URL=https://example.com
