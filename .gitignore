# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 원본 에셋 (용량 큼, 개인정보) — 최적화 결과물만 커밋
/assets/
/weddingPhoto/

# 로컬 환경변수
.env*.local

# playwright
/.playwright-mcp/
/screenshots/

# 환경변수 견본은 커밋
!.env.example
